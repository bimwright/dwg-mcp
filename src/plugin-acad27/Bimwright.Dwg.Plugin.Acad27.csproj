<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Bimwright.Dwg.Plugin</RootNamespace>
    <AssemblyName>Bimwright.Dwg.Plugin.Acad27</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AutoCadVersionYear>2027</AutoCadVersionYear>
    <DefineConstants>$(DefineConstants);ACAD2027;ACAD2025_OR_GREATER;ACAD2026_OR_GREATER;ACAD2027_OR_GREATER</DefineConstants>
    <AutoCad2027Dir Condition="'$(AutoCad2027Dir)' == ''">C:\Program Files\Autodesk\AutoCAD 2027</AutoCad2027Dir>
  </PropertyGroup>

  <Target Name="ValidateAutoCadReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AutoCad2027Dir)\accoremgd.dll') or !Exists('$(AutoCad2027Dir)\acdbmgd.dll') or !Exists('$(AutoCad2027Dir)\acmgd.dll')"
           Text="AutoCAD 2027 managed assemblies were not found under '$(AutoCad2027Dir)'. Install AutoCAD 2027 or build with /p:AutoCad2027Dir=&quot;C:\Path\To\AutoCAD 2027&quot;." />
  </Target>

  <ItemGroup>
    <Compile Include="..\plugin-acad24\App.cs" Link="App.cs" />
    <Compile Include="..\shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCad2027Dir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCad2027Dir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AutoCad2027Dir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\shared\assets\fonts\OpenSans-CondensedLight.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Fonts\OpenSans-CondensedLight.ttf</TargetPath>
    </Content>
  </ItemGroup>
</Project>
