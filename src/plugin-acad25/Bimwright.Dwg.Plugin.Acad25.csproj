<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Bimwright.Dwg.Plugin</RootNamespace>
    <AssemblyName>Bimwright.Dwg.Plugin.Acad25</AssemblyName>
    <Version>2.1.2</Version>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
    <AutoCadVersionYear>2025</AutoCadVersionYear>
    <DefineConstants>$(DefineConstants);ACAD2025;ACAD2025_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\plugin-acad24\App.cs" Link="App.cs" />
    <Compile Include="..\shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- AutoCAD 2025 (R25.0) managed assemblies come from Autodesk's AutoCAD.NET package.
       Compile-time only: AutoCAD loads its own copies, so they are never redistributed. -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\shared\assets\fonts\OpenSans-CondensedLight.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Fonts\OpenSans-CondensedLight.ttf</TargetPath>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\scripting\Bimwright.Dwg.Scripting.csproj" />
  </ItemGroup>
</Project>
