<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="..\..\src\shared\Views\Toast\*.cs" Exclude="..\..\src\shared\Views\Toast\ToastRuntime.cs" LinkBase="Toast" />
    <Compile Include="..\..\src\shared\Security\ErrorSanitizer.cs" Link="ErrorSanitizer.cs" />
    <Compile Include="..\..\src\shared\Security\SecretMasker.cs" Link="SecretMasker.cs" />
  </ItemGroup>
</Project>
